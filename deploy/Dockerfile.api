FROM python:3.11-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
COPY pyproject.toml .
COPY packages/ packages/
COPY apps/jb_api/ apps/jb_api/
COPY deploy/alembic.ini deploy/alembic.ini
COPY deploy/alembic/ deploy/alembic/
RUN pip install -i ${PIP_INDEX_URL} ".[pg,worker]" && useradd -m appuser && mkdir -p /data/uploads && chown appuser /data/uploads
USER appuser
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/api/health')"
CMD ["uvicorn", "jb_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
